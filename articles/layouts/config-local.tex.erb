\makeatletter
<%- if @config['techbooster'] && @config['techbooster']['cover_fit_page'] -%>
\recls@coverfitpagetrue
<%- end -%>
<%- if @config['techbooster'] && @config['techbooster']['backcoverimage'] -%>
<%-   raw = @config['techbooster']['backcoverimage'].to_s -%>
<%-   dir = @config['imagedir'] || 'images' -%>
<%-   resolve = lambda do |d, name| -%>
<%-     cand = File.join(@basedir, d, name) -%>
<%-     return name if File.file?(cand) -%>
<%-     found = Dir[File.join(@basedir, d, name + '.*')].sort.first -%>
<%-     found ? found.sub(File.join(@basedir, d) + '/', '') : nil -%>
<%-   end -%>
<%-   primary = resolve.call(dir, raw) || raw -%>
<%-   fallback = resolve.call('images', raw) || raw -%>
<%-   if dir != 'images' -%>
<%-     begin -%>
<%-       src = File.join(@basedir, 'images', fallback) -%>
<%-       dst = File.join(@path, 'images', fallback) -%>
<%-       FileUtils.mkdir_p(File.dirname(dst)) -%>
<%-       FileUtils.cp(src, dst) if File.file?(src) && !File.file?(dst) -%>
<%-     rescue -%>
<%-     end -%>
<%-   end -%>
\def\techbooster@coverimage{./<%= dir %>/<%= primary %>}
\def\techbooster@coverimagefallback{./images/<%= fallback %>}
<%- end -%>
\makeatother
