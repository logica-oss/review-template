\makeatletter
<%- if @config['techbooster'] && @config['techbooster']['cover_fit_page'] -%>
\recls@coverfitpagetrue
<%- end -%>
<%- if @config['techbooster'] && @config['techbooster']['backcoverimage'] -%>
<%-   backcover = @config['techbooster']['backcoverimage'].to_s -%>
<%-   imagedir = (@config['imagedir'] || 'images').to_s.chomp('/') -%>
<%-   find_image = lambda do |search_dir| -%>
<%-     exact = File.join(@basedir, search_dir, backcover) -%>
<%-     return backcover if File.file?(exact) -%>
<%-     matched = Dir[File.join(@basedir, search_dir, backcover + '.*')].sort.first -%>
<%-     next nil if matched.nil? -%>
<%-     matched.sub(File.join(@basedir, search_dir, ''), '') -%>
<%-   end -%>
<%-   primary_image = find_image.call(imagedir) || backcover -%>
<%-   fallback_image = find_image.call('images') || backcover -%>
<%-   if imagedir != 'images' -%>
<%-     begin -%>
<%-       staged = File.join(@path, 'images', fallback_image) -%>
<%-       FileUtils.mkdir_p(File.dirname(staged)) -%>
<%-       FileUtils.cp(File.join(@basedir, 'images', fallback_image), staged) unless File.file?(staged) -%>
<%-     rescue StandardError -%>
<%-     end -%>
<%-   end -%>
\def\techbooster@coverimage{./<%= imagedir %>/<%= primary_image %>}
\def\techbooster@coverimagefallback{./images/<%= fallback_image %>}
<%- end -%>
\makeatother
